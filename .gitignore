.venv/
__pycache__/
*.pyc
.pytest_cache/
.worktrees/
# 模型/专家权重等大文件不入库(通过环境变量指向本地/tmp)
*.safetensors
/models/
/experts/
# native 构建产物不入库(源码在 native/,产物由 make/cmake 现场生成)
native/ext/build/
# bench/ 下编译出的一次性基准二进制(无后缀)
native/bench/pack_loader
native/bench/array_bench
native/bench/qlinear_bench
native/bench/compute_buffer_bench
native/bench/metal_staging_bench
native/bench/metal_fused_moe_bench
native/bench/native_moe_runner
native/bench/mmap_global_gather_spike
# benchmark 一次性运行产物(JSON/日志):报告 .md 仍入库,原始跑数不入库
benchmarks/reports/*.json
benchmarks/reports/*.log
# 由 `make -C native/ext native_moe_ext` 生成的 MLX 扩展(.so 不入库,需现场编译)
mlx_streaming/native_moe_ext*.so
# 模型权重软链与 GPU trace 等大体积产物不入库
/models
*.gputrace/
# 演示录屏/转码产物不入库(已托管在 GitHub Release,README 引用其 URL)
*.mov
vates-demo.mp4
vates-demo-poster.png
# 一次性下载/构建暂存脚本与日志(不入库)
/dl_*.sh
/dl_*.log
/build_4bit.sh
/build_4bit.log
/extract_mtp.log
/dl_model.py
